# ---- raw data and generated local views ----
data/*
!data/README.md

# ---- research files that are already selectively tracked ----
research/*
!research/README.md
!research/*.md
!research/*.pdf

# ---- artifacts: data contracts are tracked, other artifacts are local ----
artifacts/*
!artifacts/README.md
!artifacts/data/
!artifacts/data/**
# The 53MB uncompressed manifest is reproducible locally; Git tracks the gzip contract.
artifacts/data/dlcpd25/manifest.csv

# ---- legacy archive: keep reports/metrics, never commit weights ----
legacy/*
!legacy/README.md
!legacy/v1-resnet50-joint/
legacy/v1-resnet50-joint/**/*.pt
legacy/v1-resnet50-joint/**/*.pth
legacy/v1-resnet50-joint/**/*.onnx

# ---- python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
*.egg-info/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.venv/
build/
dist/

# ---- model weights / binary build outputs ----
*.pt
*.pth
*.onnx
*.engine
*.tflite
outputs/
runs/

# ---- misc ----
*.log
*.tmp
*~
.DS_Store
.idea/
.vscode/
